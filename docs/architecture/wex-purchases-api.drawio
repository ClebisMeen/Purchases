        <mxCell id="yd84iUG4v3_8BRGIKZjk-293" parent="yd84iUG4v3_8BRGIKZjk-270" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;Saída para Internet (NAT Gateway / Internet Gateway)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Permite que recursos privados acessem serviços externos de forma controlada, sem expor diretamente os sistemas internos.&lt;/div&gt;" vertex="1">

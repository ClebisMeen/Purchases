        <mxCell id="yd84iUG4v3_8BRGIKZjk-280" parent="yd84iUG4v3_8BRGIKZjk-270" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Corporate Data Center – Users/Devices&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Origem dos acessos (usuários e dispositivos corporativos). Representa quem consome a aplicação e reforça o contexto de rede controlada e segurança bancária.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="131.5170278637771" width="449" x="69.5" y="14.81733746130031" as="geometry" />
        </mxCell>
        <mxCell id="yd84iUG4v3_8BRGIKZjk-281" parent="yd84iUG4v3_8BRGIKZjk-270" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Entrada Pública AWS (Route53 + WAF + CloudFront)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Camada responsável por DNS, proteção e entrega rápida do conteúdo.&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;O Route53 resolve o domínio, o WAF filtra ataques e o CloudFront entrega o frontend com baixa latência e cache.&lt;/div&gt;" vertex="1">
          <mxGeometry height="128.1733746130031" width="450" x="68.5" y="93.90712074303406" as="geometry" />
        </mxCell>
        <mxCell id="yd84iUG4v3_8BRGIKZjk-283" parent="yd84iUG4v3_8BRGIKZjk-270" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;API Gateway&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Ponto oficial de entrada das APIs. Centraliza autenticação, controle de tráfego, auditoria e roteamento para o backend.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="134.86068111455108" width="450" x="68.5" y="172.7120743034056" as="geometry" />
        </mxCell>
        <mxCell id="yd84iUG4v3_8BRGIKZjk-284" parent="yd84iUG4v3_8BRGIKZjk-270" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Load Balancer (ALB)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Distribui as requisições recebidas para os serviços internos do backend, garantindo escalabilidade e alta disponibilidade.&lt;/div&gt;" vertex="1">
          <mxGeometry height="127.05882352941177" width="449" x="69.5" y="239.11455108359132" as="geometry" />
        </mxCell>
        <mxCell id="yd84iUG4v3_8BRGIKZjk-285" parent="yd84iUG4v3_8BRGIKZjk-270" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;VPC (Subnets privadas e públicas)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Rede isolada onde ficam os serviços críticos. Define regras de segurança, subnets privadas e organização do tráfego interno.&lt;/div&gt;" vertex="1">
          <mxGeometry height="131.5170278637771" width="450" x="69.5" y="303.4024767801858" as="geometry" />
        </mxCell>
        <mxCell id="yd84iUG4v3_8BRGIKZjk-286" parent="yd84iUG4v3_8BRGIKZjk-270" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;p data-start=&quot;1872&quot; data-end=&quot;1968&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Backend em ECS (Microservices C# em Multi-AZ)&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;1872&quot; data-end=&quot;1968&quot; style=&quot;font-size: 12px;&quot;&gt;Microsserviços em C# rodando em containers dentro de subnets privadas, distribuídos em duas Availability Zones para alta disponibilidade e escalabilidade automática.&lt;/p&gt;" vertex="1">
          <mxGeometry height="125.94427244582043" width="449" x="69.5" y="353.5758513931888" as="geometry" />
        </mxCell>
        <mxCell id="yd84iUG4v3_8BRGIKZjk-287" parent="yd84iUG4v3_8BRGIKZjk-270" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;" value="&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Camada de Dados (RDS MySQL + Redis)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Armazena dados transacionais no RDS e utiliza Redis como cache para melhorar performance e reduzir carga no banco.&lt;/div&gt;" vertex="1">
          <mxGeometry height="138.20433436532508" width="449" x="68.5" y="441.20743034055727" as="geometry" />
        </mxCell>
